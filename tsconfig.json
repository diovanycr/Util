{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "globals.d.ts",
    "js/**/*",
    "scripts/**/*",
    "tests/**/*",
    "functions/**/*",
    "sw.js"
  ],
  "exclude": [
    "node_modules",
    "functions"
  ]
}
